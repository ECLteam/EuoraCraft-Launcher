{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Shanghai",
  "addLabels": ["dependencies"],
  "commitMessagePrefix": "deps:",
  "schedule": [
	"on friday"
  ],
  "packageRules": [
    {
      "matchManagers":["pip_setup","pip_requirements"],
      "groupName": "python-deps"
    },
    {
      "matchManagers":["pip_setup","pip_requirements"],
      "matchPackageNames":["cryptography"],
      "enabled": false
    },
    {
      "matchCategories":["ci"],
      "matchDepTypes":["action"],
      "matchDatasources":["github-tags"],
      "groupName": "action-deps"
    },
    {
      "matchCategories":["ci"],
      "matchDepTypes":["action"],
      "matchDatasources":["github-tags"],
      "matchPackageNames":["/^luyanci\\//"],
      "enabled": false
    }
  ]
}
